[Unit]
Description=Lokale Weboberfläche für die HVV-Abfahrtsanzeige
After=network.target
Wants=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=hvv-anzeiger
Group=hvv-anzeiger
EnvironmentFile=-/etc/hvv-anzeiger.env
EnvironmentFile=-/opt/hvv-anzeiger/var/web.env
Environment=PYTHONUNBUFFERED=1
Environment=HVV_WIFI_INTERFACE=wlan0
Environment=HVV_HEALTH_FILE=/opt/hvv-anzeiger/var/health.json
Environment=HVV_GEOFOX_RATE_LIMIT_FILE=/opt/hvv-anzeiger/var/geofox-rate-limit.json
Environment=HVV_WEB_ENV_FILE=/opt/hvv-anzeiger/var/web.env
ExecStart=/opt/hvv-anzeiger/.venv/bin/python -m hvv_display.web --host 0.0.0.0 --port 8080 --config /opt/hvv-anzeiger/config.json --cache /opt/hvv-anzeiger/var/stations.json --departure-cache /opt/hvv-anzeiger/var/departures.json --credentials /opt/hvv-anzeiger/var/credentials.env --tls-certfile /etc/hvv-anzeiger/web.crt --tls-keyfile /etc/hvv-anzeiger/web.key
Restart=always
RestartSec=5
TimeoutStopSec=10
UMask=0077
# The restart button uses the single sudoers command documented in README.md.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=/opt/hvv-anzeiger/var

[Install]
WantedBy=multi-user.target
